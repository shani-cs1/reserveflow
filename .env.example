# ==============================================================================
# ReserveFlow Environment Variables Reference
# ==============================================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env
#
# On Windows PowerShell:
#   Copy-Item .env.example .env
# ==============================================================================

# Node Environment ('development', 'test', 'production')
NODE_ENV=development

# Server port for HTTP API and React application
PORT=3000

# PostgreSQL Connection String
# For Docker Compose: postgres://reserveflow:reserveflow_secret_pass@postgres:5432/reserveflow_db
# For Local Host PostgreSQL: postgres://reserveflow:reserveflow_secret_pass@localhost:5432/reserveflow_db
# If left empty, the application falls back automatically to embedded PostgreSQL (PGlite WASM)
DATABASE_URL=postgres://reserveflow:reserveflow_secret_pass@localhost:5432/reserveflow_db

# Optional: isolated database for DB-backed tests.
# Tests never fall back to DATABASE_URL. If this is unset, tests use in-memory PGlite.
# If this targets the same database as DATABASE_URL, the test bootstrap refuses to run.
TEST_DATABASE_URL=

# PostgreSQL credentials for Docker Compose services
POSTGRES_DB=reserveflow_db
POSTGRES_USER=reserveflow
POSTGRES_PASSWORD=reserveflow_secret_pass

# JSON Web Token Secret for signing authentication tokens
# Production requires an explicit secret of at least 32 characters.
# Startup fails in production when the secret is missing, empty, or a known default.
# Generate a cryptographically secure random string using:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=reserveflow-dev-secret-key-must-be-changed-in-prod-12345

# JWT Expiration Period (e.g. '24h', '7d')
JWT_EXPIRES_IN=24h

# Opt-in demo seeding for local development/test only ('true' or 'false').
# Ignored/rejected in production. Default is false.
DEMO_SEED=false

# Allowed CORS Origin for HTTP API clients ('*' or specific frontend domain)
CORS_ORIGIN=*

# Structured Logging Level ('fatal', 'error', 'warn', 'info', 'debug', 'trace')
LOG_LEVEL=info

# Optional: Bearer token to protect the Prometheus /metrics endpoint from unauthorized scraping.
# When empty, /metrics requires an authenticated ADMIN JWT instead (fail-closed).
METRICS_TOKEN=
